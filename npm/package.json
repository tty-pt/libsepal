{
  "name": "@tty-pt/sepal",
  "version": "1.5.1",
  "type": "module",
  "description": "Universal Node.js and Browser bindings for libsepal Vector Cosine & Hamming Sketch Engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prebuilds",
    "include",
    "assets",
    "*.pc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "mkdir -p build/Release && gcc -O3 -fPIC -shared -I/usr/include/node -I../include -I../../libcorm/include native/sepal_napi.c -L../lib -L../../libcorm/lib -Wl,-rpath,\\$ORIGIN/../../../lib:\\$ORIGIN/../../../../libcorm/lib -L/usr/lib -lsepal -lcorm -lm -o build/Release/sepal_node.node",
    "build:wasm": "make -C .. wasm",
    "build": "npm run build:native && npm run build:wasm",
    "test": "node --test tests/sepal.test.mjs"
  },
  "peerDependencies": {
    "@tty-pt/corm": ">=2.4.0",
    "@tty-pt/stele": ">=1.7.0"
  },
  "devDependencies": {
    "@tty-pt/corm": "^2.4.0",
    "@tty-pt/stele": "^1.7.0"
  },
  "keywords": [
    "sepal",
    "libsepal",
    "vector",
    "cosine",
    "embeddings",
    "similarity",
    "ann",
    "hamming"
  ],
  "author": "Paulo Quirino",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tty-pt/libsepal.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/tty-pt/libsepal/tree/main/npm#readme",
  "bugs": {
    "url": "https://github.com/tty-pt/libsepal/issues"
  }
}
